{
  "id": "strategy_preset_regime_chan_tactics",
  "name": "上证大盘宏观+纯缠论+牛熊左右侧战术联动策略树",
  "version": "1.0.0",
  "kind": "decision_flow",
  "status": "active",
  "author": "Mist Quant Team",
  "description": "以双频状态机上证大盘大周期牛熊为宏观总舵手，牛市顺势执行缠论形态主门禁与微观左右侧战术止盈增强，熊市执行双中枢背驰极限抄底与破位极速逃命清仓防守。",
  "tags": ["regime", "chan", "tactics", "bull-bear-adaptive", "multi-scale"],
  "targetUniverse": ["000001", "510050", "510300"],
  "supportedPeriods": [5, 15, 30, 60, 1440],
  "mountedPlugins": [
    {
      "pluginId": "plugin.regime.shanghai-index",
      "name": "上证指数全局牛熊判定插件",
      "role": "MACRO_REGIME_ROOT",
      "params": {
        "mode": "dual_speed",
        "fastMaPeriod": 20,
        "slowMaPeriod": 60,
        "breakoutThreshold": 0.005
      }
    },
    {
      "pluginId": "plugin.chan.bsp",
      "name": "牛市缠论形态主门禁",
      "role": "BULL_PRIMARY_MORPHOLOGY",
      "params": {
        "units": "bi",
        "direction": "both",
        "points": {
          "first": true,
          "second": true,
          "third": true
        },
        "requiredBarCount": 60,
        "deduplicate": true
      }
    },
    {
      "pluginId": "plugin.tactics.bull-left-right-bsp",
      "name": "牛市微观左右侧战术增强插件",
      "role": "BULL_MICRO_TACTICS",
      "params": {
        "fallbackToMainBars": true,
        "oversoldThreshold": 0.05,
        "slopeThreshold": 0.005
      }
    },
    {
      "pluginId": "plugin.tactics.bear-left-right-bsp",
      "name": "熊市左右侧战术防守插件",
      "role": "BEAR_DEFENSIVE_TACTICS",
      "params": {
        "fallbackToMainBars": true,
        "slopeThreshold": 0.008
      }
    }
  ],
  "decisionFlow": {
    "id": "guard_regime_shanghai",
    "type": "GUARD",
    "name": "上证宏观大周期滤网",
    "pluginId": "plugin.regime.shanghai-index",
    "params": {
      "mode": "dual_speed"
    },
    "requiredAction": "BUY",
    "minConfidence": 0.6,
    "onPass": {
      "id": "guard_bull_chan_bsp",
      "type": "GUARD",
      "name": "牛市缠论形态主门禁",
      "pluginId": "plugin.chan.bsp",
      "params": {
        "units": "bi",
        "direction": "both",
        "points": {
          "first": true,
          "second": true,
          "third": true
        },
        "requiredBarCount": 60,
        "deduplicate": true
      },
      "requiredAction": "BOTH",
      "minConfidence": 0.5,
      "onPass": {
        "id": "term_bull_chan_pass",
        "type": "TERMINAL",
        "action": "INHERIT",
        "signalTag": "BULL_CHAN_BSP",
        "reason": "宏观牛市顺势下缠论标准形态买卖点确立"
      },
      "onFail": {
        "id": "guard_bull_tactics",
        "type": "GUARD",
        "name": "牛市微观左右侧战术增强",
        "pluginId": "plugin.tactics.bull-left-right-bsp",
        "params": {
          "fallbackToMainBars": true
        },
        "requiredAction": "BOTH",
        "minConfidence": 0.5,
        "onPass": {
          "id": "term_bull_tactics_pass",
          "type": "TERMINAL",
          "action": "INHERIT",
          "signalTag": "BULL_TACTICS_SIGNAL",
          "reason": "宏观牛市下触发左右侧微观战术信号"
        },
        "onFail": {
          "id": "term_bull_abort",
          "type": "TERMINAL",
          "action": "ABORT",
          "reason": "牛市环境中未满足缠论形态或左右侧战术触发条件"
        }
      }
    },
    "onFail": {
      "id": "guard_regime_bear_check",
      "type": "GUARD",
      "name": "上证宏观走熊与防守研判",
      "pluginId": "plugin.regime.shanghai-index",
      "params": {
        "mode": "dual_speed"
      },
      "requiredAction": "SELL",
      "minConfidence": 0.6,
      "onPass": {
        "id": "guard_bear_tactics",
        "type": "GUARD",
        "name": "熊市左右侧战术研判门禁",
        "pluginId": "plugin.tactics.bear-left-right-bsp",
        "params": {
          "fallbackToMainBars": true
        },
        "requiredAction": "BOTH",
        "minConfidence": 0.5,
        "onPass": {
          "id": "term_bear_tactics_pass",
          "type": "TERMINAL",
          "action": "INHERIT",
          "signalTag": "BEAR_TACTICS_SIGNAL",
          "reason": "熊市左右侧战术买点触发"
        },
        "onFail": {
          "id": "term_regime_defend_sell",
          "type": "TERMINAL",
          "action": "SELL",
          "signalTag": "REGIME_DEFEND_SELL",
          "reason": "上证指数宏观走熊清仓防守"
        }
      },
      "onFail": {
        "id": "term_regime_neutral_abort",
        "type": "TERMINAL",
        "action": "ABORT",
        "reason": "上证指数震荡纠缠，维持观望"
      }
    }
  },
  "backtestBaseline": {
    "target": "000001 (上证指数)",
    "period": "1440 (日线)",
    "timeRange": "2020-01-01 ~ 2026-10-14",
    "initialCash": 1000000,
    "endingEquity": 990600,
    "totalReturn": -0.0094,
    "sharpeRatio": -0.3123,
    "maxDrawdown": 0.1632,
    "totalTrades": 17,
    "winRate": 0.4706,
    "payoffRatio": 1.088,
    "averageHoldingBars": 17.7,
    "mitigation": "彻底规避了 2024 年暴跌大坑，持仓周期从 248 天锐减为 17.7 天短波段"
  }
}
